{
  "name": "nukeeper",
  "displayName": "NuKeeper",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "tinou0902",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://gitlab.hexxusdata.com/perso/nukeeper/vscode.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "nuget",
    "dotnet",
    "packages",
    "csproj"
  ],
  "activationEvents": [
    "workspaceContains:**/*.csproj"
  ],
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nukeeper",
          "title": "%viewContainer.nukeeper%",
          "icon": "media/nukeeper.svg"
        }
      ]
    },
    "views": {
      "nukeeper": [
        {
          "id": "nukeeper.packages",
          "name": "%view.packages%",
          "icon": "media/nukeeper.svg",
          "when": "nukeeper.hasProjects"
        }
      ]
    },
    "commands": [
      {
        "command": "nukeeper.refresh",
        "title": "%command.refresh%",
        "category": "NuKeeper",
        "icon": "$(refresh)"
      },
      {
        "command": "nukeeper.filter",
        "title": "%command.filter%",
        "category": "NuKeeper",
        "icon": "$(filter)"
      },
      {
        "command": "nukeeper.updateToLatest",
        "title": "%command.updateToLatest%",
        "category": "NuKeeper",
        "icon": "$(arrow-up)"
      },
      {
        "command": "nukeeper.chooseVersion",
        "title": "%command.chooseVersion%",
        "category": "NuKeeper",
        "icon": "$(versions)"
      },
      {
        "command": "nukeeper.remove",
        "title": "%command.remove%",
        "category": "NuKeeper",
        "icon": "$(trash)"
      },
      {
        "command": "nukeeper.openOnNuGet",
        "title": "%command.openOnNuGet%",
        "category": "NuKeeper",
        "icon": "$(link-external)"
      },
      {
        "command": "nukeeper.openProjectFile",
        "title": "%command.openProjectFile%",
        "category": "NuKeeper",
        "icon": "$(go-to-file)"
      },
      {
        "command": "nukeeper.manageSolution",
        "title": "%command.manageSolution%",
        "category": "NuKeeper",
        "icon": "$(package)"
      },
      {
        "command": "nukeeper.manageProject",
        "title": "%command.manageProject%",
        "category": "NuKeeper",
        "icon": "$(package)"
      },
      {
        "command": "nukeeper.manageProjectPackage",
        "title": "%command.manageProjectPackage%",
        "category": "NuKeeper"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nukeeper.updateToLatest",
          "when": "false"
        },
        {
          "command": "nukeeper.chooseVersion",
          "when": "false"
        },
        {
          "command": "nukeeper.remove",
          "when": "false"
        },
        {
          "command": "nukeeper.openOnNuGet",
          "when": "false"
        },
        {
          "command": "nukeeper.openProjectFile",
          "when": "false"
        },
        {
          "command": "nukeeper.manageProjectPackage",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "nukeeper.manageSolution",
          "when": "view == nukeeper.packages",
          "group": "navigation@0"
        },
        {
          "command": "nukeeper.filter",
          "when": "view == nukeeper.packages",
          "group": "navigation@1"
        },
        {
          "command": "nukeeper.refresh",
          "when": "view == nukeeper.packages",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "nukeeper.updateToLatest",
          "when": "view == nukeeper.packages && viewItem =~ /\\boutdated\\b/",
          "group": "inline@1"
        },
        {
          "command": "nukeeper.chooseVersion",
          "when": "view == nukeeper.packages && viewItem =~ /\\bpackage\\b/",
          "group": "inline@2"
        },
        {
          "command": "nukeeper.updateToLatest",
          "when": "view == nukeeper.packages && viewItem =~ /\\boutdated\\b/",
          "group": "1_modify@1"
        },
        {
          "command": "nukeeper.chooseVersion",
          "when": "view == nukeeper.packages && viewItem =~ /\\bpackage\\b/",
          "group": "1_modify@2"
        },
        {
          "command": "nukeeper.remove",
          "when": "view == nukeeper.packages && viewItem =~ /\\bdirect\\b/",
          "group": "1_modify@3"
        },
        {
          "command": "nukeeper.openOnNuGet",
          "when": "view == nukeeper.packages && viewItem =~ /\\bpackage\\b/",
          "group": "2_open@1"
        },
        {
          "command": "nukeeper.refresh",
          "when": "view == nukeeper.packages && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "nukeeper.openProjectFile",
          "when": "view == nukeeper.packages && viewItem == project",
          "group": "2_open@1"
        },
        {
          "command": "nukeeper.manageProject",
          "when": "view == nukeeper.packages && viewItem == project",
          "group": "1_manage@1"
        },
        {
          "command": "nukeeper.manageProjectPackage",
          "when": "view == nukeeper.packages && viewItem =~ /\\bpackage\\b/",
          "group": "0_manage@1"
        }
      ],
      "explorer/context": [
        {
          "command": "nukeeper.manageProject",
          "when": "resourceExtname == .csproj",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "nukeeper.manageProject",
          "when": "resourceExtname == .csproj",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node --target=node22 --sourcemap && esbuild src/manager/webview/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --target=es2022 --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node --target=node22 --sourcemap --watch=forever & esbuild src/manager/webview/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --target=es2022 --sourcemap --watch=forever",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node --target=node22 --minify && esbuild src/manager/webview/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --target=es2022 --minify && vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
