{
  "name": "packwise",
  "displayName": "Packwise — Package Manager for NuGet, npm and PyPI",
  "description": "%description%",
  "version": "0.5.3",
  "publisher": "sporange-dev",
  "private": true,
  "type": "module",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tinou0902/packwise.git"
  },
  "bugs": {
    "url": "https://github.com/tinou0902/packwise/issues"
  },
  "homepage": "https://github.com/tinou0902/packwise#readme",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "nuget",
    "dotnet",
    ".NET",
    "package manager",
    "packages",
    "csproj",
    "sln",
    "slnx",
    "npm",
    "package.json",
    "workspaces",
    "dependencies",
    "python",
    "pypi",
    "uv",
    "pyproject"
  ],
  "activationEvents": [
    "workspaceContains:**/*.{sln,slnx}",
    "workspaceContains:**/package.json",
    "workspaceContains:**/pyproject.toml"
  ],
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "packwise",
          "title": "%viewContainer.packwise%",
          "icon": "media/packwise.svg"
        }
      ]
    },
    "views": {
      "packwise": [
        {
          "id": "packwise.roots",
          "name": "%view.roots%",
          "icon": "media/packwise.svg",
          "when": "packwise.hasRoots"
        }
      ]
    },
    "configuration": {
      "title": "Packwise",
      "properties": {
        "packwise.ecosystems": {
          "type": "object",
          "markdownDescription": "%config.ecosystems%",
          "properties": {
            "nuget": {
              "type": "boolean",
              "default": true,
              "description": "NuGet (.NET solutions)"
            },
            "npm": {
              "type": "boolean",
              "default": true,
              "description": "npm (package.json)"
            },
            "pypi": {
              "type": "boolean",
              "default": true,
              "description": "PyPI (Python, pyproject.toml managed by uv)"
            }
          },
          "additionalProperties": false,
          "default": {
            "nuget": true,
            "npm": true,
            "pypi": true
          }
        }
      }
    },
    "commands": [
      {
        "command": "packwise.manage",
        "title": "%command.manage%",
        "category": "Packwise",
        "icon": "$(package)"
      },
      {
        "command": "packwise.refresh",
        "title": "%command.refresh%",
        "category": "Packwise",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "packwise.refresh",
          "when": "view == packwise.roots",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "packwise.manage",
          "when": "resourceExtname =~ /^\\.slnx?$/ || resourceFilename == package.json || resourceFilename == pyproject.toml",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "packwise.manage",
          "when": "resourceExtname =~ /^\\.slnx?$/ || resourceFilename == package.json || resourceFilename == pyproject.toml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node --target=node22 --sourcemap && esbuild src/manager/webview/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --target=es2022 --loader:.svg=text --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node --target=node22 --sourcemap --watch=forever & esbuild src/manager/webview/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --target=es2022 --loader:.svg=text --sourcemap --watch=forever",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node --target=node22 --minify && esbuild src/manager/webview/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --target=es2022 --loader:.svg=text --minify && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.105.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "ovsx": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  }
}
